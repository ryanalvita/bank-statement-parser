---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Bank Statement Parser"
  description="Parse ABN AMRO bank statement PDFs and copy transactions to your spreadsheet."
>
  <main id="main-content" role="main" class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-semibold text-gray-900">Bank Statement Parser</h1>
    <p class="mt-2 text-sm text-gray-700">
      Parse ABN AMRO bank statement PDFs and copy transactions to your spreadsheet.
    </p>
    <p class="mt-2 text-sm text-gray-700">
      Your PDF is processed locally in your browser and is never uploaded.
    </p>

    <section class="mt-6 rounded-md border border-gray-300 bg-white p-4">
      <h2 class="text-sm font-medium text-gray-900">File Upload</h2>
      <p class="mt-2 text-sm text-gray-600">Upload placeholder. PDF picker will be added in the next step.</p>
    </section>
  </main>
</Layout>
