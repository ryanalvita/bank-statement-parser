---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import ParserInteraction from "../components/parser/ParserInteraction";
import { SITE } from "../config/site.mjs";
---

<Layout
	title={`Bank Statement Parser | ${SITE.title}`}
	description="Parse ABN AMRO bank statement PDFs and copy transactions to your spreadsheet."
	canonicalURL={SITE.url}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-5xl mx-auto px-4 pt-16 pb-6 text-center">
			<ScrollReveal client:load>
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900">
					Parse your bank statement, safely.
				</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.15}>
				<p class="mt-4 text-base md:text-lg text-gray-600 max-w-3xl mx-auto">
					Parse your bank statement PDFs and copy transactions into your
					spending tracker spreadsheet.
				</p>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.2}>
				<p class="mt-2 text-sm text-gray-500 max-w-3xl mx-auto">
					Your bank statement PDF is safely processed locally in your browser
					and is never uploaded.
				</p>
			</ScrollReveal>
		</section>

		<section class="max-w-5xl mx-auto px-4 pb-20">
			<ScrollReveal client:idle delay={0.1}>
				<ParserInteraction client:load />
			</ScrollReveal>
		</section>
	</main>
	<Footer />
</Layout>
