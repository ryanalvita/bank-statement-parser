---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import ParserInteraction from "../components/parser/ParserInteraction";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Bank Statement Parser | ${SITE.title}`}
  description="Parse ABN AMRO bank statement PDFs and copy transactions to your spreadsheet."
  canonicalURL={SITE.url}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-6xl mx-auto px-4 pt-20 pb-10 text-center">
      <ScrollReveal client:load>
        <h1 class="text-5xl md:text-6xl font-bold text-gray-900">
          Bank Statement Parser
        </h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.15}>
        <p class="mt-5 text-xl text-gray-600 max-w-2xl mx-auto">
          Parse ABN AMRO statement PDFs and copy transactions into your spreadsheet in one step.
        </p>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.25}>
        <p class="mt-3 text-sm text-gray-600 max-w-2xl mx-auto">
          Your PDF is processed locally in your browser and is never uploaded.
        </p>
      </ScrollReveal>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-20">
      <ScrollReveal client:idle delay={0.2}>
        <div class="rounded-2xl border border-gray-200 bg-white p-6 md:p-8 shadow-sm">
          <h2 class="text-2xl font-semibold text-gray-900">Upload and Parse</h2>
          <p class="mt-2 text-sm text-gray-600">
            Select your PDF to extract, parse, and copy TSV output.
          </p>
          <ParserInteraction client:load />
        </div>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
