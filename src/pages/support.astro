---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
---

<Layout
	title={`Support | ${SITE.title}`}
	description="Support Bank Statement Parser development and help keep the tool free and improving."
	canonicalURL={`${SITE.url}/support`}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-3xl mx-auto px-4 py-20">
			<ScrollReveal client:idle>
				<h1 class="text-5xl font-bold text-gray-900 mb-4">Support</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.1}>
				<p class="text-xl text-gray-600 mb-8">
					This app is maintained independently during my spare time with the
					goal of keeping it free and without ads, so it could remain useful for
					everyone. 🌱
				</p>
			</ScrollReveal>

			<ScrollReveal client:load delay={0.1}>
				<p class="text-xl text-gray-600 mb-8">
					If this app saved you time or make your life easier, how about fueling
					development with a coffee? It will help both the code and the caffeine
					flowing! 🧑‍💻
				</p>
			</ScrollReveal>

			<ScrollReveal client:load delay={0.3}>
				<a
					href="https://buymeacoffee.com/ryanalvita"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-2 rounded-lg bg-yellow-300 px-4 py-2 font-semibold text-black hover:bg-yellow-400 transition-colors"
				>
					<Icon name="tabler:coffee" class="h-5 w-5" aria-hidden="true" />
					Buy me a coffee
				</a>
			</ScrollReveal>
		</section>
	</main>
	<Footer />
</Layout>
