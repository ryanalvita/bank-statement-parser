---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
---

<Layout
	title={`Feedback | ${SITE.title}`}
	description="Share your feedback for Bank Statement Parser, report issues, and suggest improvements."
	canonicalURL="/feedback"
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-3xl mx-auto px-4 py-20">
			<ScrollReveal client:idle>
				<h1 class="text-5xl font-bold text-gray-900 mb-4">Feedback</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.1}>
				<p class="text-xl text-gray-600 mb-8">
					Your feedback helps improve the app. Report bugs, suggest features, or
					share how you use the app. 💡
				</p>
			</ScrollReveal>

			<ScrollReveal client:load delay={0.1}>
				<p class="text-xl text-gray-600 mb-8">
					Feel free to reach out! I’d love to hear from you. Your insights help
					making this tool better for everyone. 🙌
				</p>
			</ScrollReveal>

			<ScrollReveal client:load delay={0.2}>
				<div class="flex flex-wrap gap-3">
					<a
						href="mailto:ryanalvita@gmail.com"
						class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-white font-medium hover:bg-blue-700 transition-colors"
					>
						<Icon name="tabler:mail" class="h-5 w-5" aria-hidden="true" />
						Send E-mail
					</a>
					<a
						href="https://github.com/ryanalvita/bank-statement-parser/issues"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-lg bg-gray-900 px-4 py-2 text-white font-medium hover:bg-black transition-colors"
					>
						<Icon
							name="tabler:brand-github"
							class="h-5 w-5"
							aria-hidden="true"
						/>
						Open GitHub Issues
					</a>
				</div>
			</ScrollReveal>
		</section>
	</main>
	<Footer />
</Layout>
