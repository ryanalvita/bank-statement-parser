---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Layout
	title={`About | ${SITE.title}`}
	description="Learn what Bank Statement Parser does, how it processes statement PDFs locally, and how to use it safely."
	canonicalURL={`${SITE.url}/about`}
>
	<Header />
	<main id="main-content" role="main">
		<section class="max-w-5xl mx-auto px-4 pt-16 pb-6 text-center">
			<ScrollReveal client:load>
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900">About</h1>
			</ScrollReveal>
			<ScrollReveal client:load delay={0.1}>
				<p class="mt-4 text-base md:text-lg text-gray-600 max-w-3xl mx-auto">
					Bank Statement Parser helps you extract transactions from bank
					statement PDFs and copy them into your spending tracker spreadsheet
					faster and safely.
				</p>
			</ScrollReveal>
		</section>

		<section class="max-w-5xl mx-auto px-4 pb-12">
			<div>
				<ScrollReveal client:idle delay={0.1}>
					<article
						class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
					>
						<h2 class="text-xl font-semibold text-gray-900">What It Does 📄</h2>
						<p class="mt-3 text-gray-600">
							Bank Statement Parser reads your statement PDF, extracts
							transaction lines, and formats them into clean structured output.
						</p>
						<p class="mt-3 text-gray-600">
							Instead of retyping rows one by one, you get structured output
							ready to paste into your spending tracker, budgeting sheet, or
							personal finance template.
						</p>
					</article>
				</ScrollReveal>

				<div class="mt-2">
					<ScrollReveal client:idle delay={0.3}>
						<article
							class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
						>
							<h2 class="text-xl font-semibold text-gray-900">
								Why This Exists ⚡
							</h2>
							<p class="mt-3 text-gray-600">
								Manual statement processing is repetitive and error-prone,
								especially if you regularly track spending in spreadsheets.
							</p>
							<p class="mt-3 text-gray-600">
								This project exists to make that workflow safer, faster, and
								easier to repeat with confidence.
							</p>
						</article>
					</ScrollReveal>
				</div>

				<div class="mt-2">
					<ScrollReveal client:idle delay={0.25}>
						<article
							class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
						>
							<h2 class="text-xl font-semibold text-gray-900">How to Use 🧭</h2>
							<ol class="mt-3 list-decimal pl-5 text-gray-600 space-y-2">
								<li>Upload your PDF statement from the homepage parser.</li>
								<li>Review extracted text and parsed transaction totals.</li>
								<li>Copy the generated TSV output into your spreadsheet.</li>
								<li>
									Use debug view when you need to inspect raw extracted text,
									then fix only the rows that need manual adjustment.
								</li>
							</ol>
						</article>
					</ScrollReveal>
				</div>

				<div class="mt-2">
					<ScrollReveal client:idle delay={0.15}>
						<article
							class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
						>
							<h2 class="text-xl font-semibold text-gray-900">
								Privacy First 🔒
							</h2>
							<p class="mt-3 text-gray-600">
								All parsing happens locally in your browser. Your statement file
								is not uploaded to an external server during normal use.
							</p>
							<p class="mt-3 text-gray-600">
								This local-first approach is designed to keep your financial
								data on your device while still giving you fast, practical
								parsing tools.
							</p>
						</article>
					</ScrollReveal>
				</div>

				<div class="mt-2">
					<ScrollReveal client:idle delay={0.2}>
						<article
							class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
						>
							<h2 class="text-xl font-semibold text-gray-900">
								Current Scope 🎯
							</h2>
							<p class="mt-3 text-gray-600">
								The current parsing rules are tuned for ABN AMRO statement
								formats.
							</p>
							<p class="mt-3 text-gray-600">
								If your statement layout differs, some rows may require manual
								review.
							</p>
							<p class="mt-3 text-gray-600">
								Parser coverage improves over time based on real statement
								examples and feedback, especially when banks change formatting.
							</p>
							<p class="mt-3 text-gray-600">
								Even with good parser coverage, a quick final check of dates,
								amounts, and balances before analysis is still recommended.
							</p>
						</article>
					</ScrollReveal>
				</div>

				<div class="mt-2">
					<ScrollReveal client:idle delay={0.12}>
						<article
							class="rounded-xl border border-gray-200 bg-white p-6 md:p-8"
						>
							<h2 class="text-xl font-semibold text-gray-900">TSV vs CSV 🔁</h2>
							<p class="mt-3 text-gray-600">
								The export format is TSV (tab-separated values), which is
								similar to CSV (comma-separated values) but uses tabs instead of
								commas to split columns.
							</p>
							<p class="mt-3 text-gray-600">
								CSV is more widely known, but bank transaction descriptions
								often contain commas. TSV helps reduce broken column splits when
								you paste directly into spreadsheet tools.
							</p>
						</article>
					</ScrollReveal>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
