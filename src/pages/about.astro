---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`About | ${SITE.title}`}
  description="Learn what Bank Statement Parser does, how it processes ABN AMRO statements locally, and how to use it safely."
  canonicalURL={`${SITE.url}/about`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-4xl mx-auto px-4 py-20">
      <ScrollReveal client:idle>
        <h1 class="text-5xl font-bold text-gray-900 mb-4">About</h1>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl text-gray-600 mb-12">
          Bank Statement Parser helps you extract ABN AMRO statement transactions from PDF files and
          copy them into spreadsheets faster.
        </p>
      </ScrollReveal>

      <div class="prose prose-lg max-w-none">
        <ScrollReveal client:load delay={0.2}>
          <h2>What It Does</h2>
          <p>
            This app reads your bank statement PDF, extracts transaction text, parses the rows, and
            generates a clean TSV output you can paste into your own sheet or workflow.
          </p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.3}>
          <h2>Privacy First</h2>
          <p>
            Your file is processed locally in your browser. The parser runs client-side and does not
            upload your statement contents to a server.
          </p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.4}>
          <h2>Current Scope</h2>
          <p>
            The current parser pipeline is focused on ABN AMRO statement formats. If your statement
            layout changes, feedback is welcome so parsing rules can be improved.
          </p>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.5}>
          <h2>How to Use</h2>
          <ol>
            <li>Open the homepage and upload your PDF statement.</li>
            <li>Review extracted and parsed transaction counts.</li>
            <li>Copy TSV output and paste it into your spreadsheet.</li>
            <li>Use the debug view when you need to inspect extracted page text.</li>
          </ol>
        </ScrollReveal>

        <ScrollReveal client:load delay={0.6}>
          <h2>Why This Exists</h2>
          <p>
            Manual copy-paste from statements is slow and error-prone. Bank Statement Parser is built
            to reduce that repetitive work while keeping your data handling simple and private.
          </p>
        </ScrollReveal>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
